# ===========================================
# Server Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ===========================================


# Server
NODE_ENV=development
PORT=5000

# Database (Supabase PostgreSQL)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h

# One-time admin provisioning (used by `npm run admin:create`)
# Do not keep ADMIN_PASSWORD in production environment after provisioning.
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE_NUMBER=9999999999
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Administrator

# CORS
CORS_ORIGIN=http://localhost:3000

# Public website origin used to build admin password reset links.
# Leave blank to reuse the first CORS_ORIGIN entry.
APP_BASE_URL=
# How long an admin password reset link stays valid, in minutes.
ADMIN_RESET_TTL_MINUTES=60

# Email delivery (optional).
# Until all four are set, reset links are not emailed: the admin dashboard
# shows the link so it can be copied and handed over directly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Logging
LOG_LEVEL=debug
